# All paths below are relative to this project, unless absolute.
RAG_RUNTIME_DIR=runtime
RAG_MILVUS_URI=http://127.0.0.1:19530
RAG_MILVUS_TIMEOUT_SECONDS=3
RAG_KB_ID=demo-debug
# Set to a complete local bge-small-zh-v1.5 directory; no auto-download.
RAG_EMBEDDING_MODEL_PATH=
RAG_EMBEDDING_BACKEND=local
# Each route returns 1..5 distinct source chunks (at most 20 candidates for reranking).
RAG_DENSE_TOP_K=5
RAG_SPARSE_TOP_K=5
RAG_BM25_TOP_K=5
RAG_RRF_K=60
# Keep false for local-only learning and verification. No key is needed for search.
RAG_ALLOW_EXTERNAL_CALLS=false
RAG_MONTHLY_BUDGET_CNY=50
# Generation adapter settings. Real paid validation is currently deferred.
RAG_DEEPSEEK_API_KEY=
RAG_DEEPSEEK_MODEL=deepseek-flash
RAG_MAX_INPUT_TOKENS=6000
RAG_MAX_OUTPUT_TOKENS=1500
RAG_PARENT_EXPANSION_ENABLED=true
# Optional remote retrieval stages; local search remains free even if these are enabled.
RAG_QUERY_REWRITE_ENABLED=false
RAG_RERANK_ENABLED=false
# Rewriting reuses RAG_DEEPSEEK_API_KEY; reranking uses your separate Bailian credential.
RAG_RERANK_API_KEY=
# Copy the full HTTPS text-rerank URL for your own account/region from Bailian docs.
RAG_RERANK_ENDPOINT=
RAG_RERANK_MODEL=qwen3-rerank
RAG_RERANK_TIMEOUT_SECONDS=20
RAG_RERANK_MAX_INPUT_TOKENS=16000
# Required before rerank calls: verified CNY price per 1M INPUT tokens and validity dates.
# Empty fields deliberately block billing rather than assume free usage.
RAG_RERANK_INPUT_CNY_PER_MILLION=
RAG_RERANK_PRICE_VERIFIED_ON=
RAG_RERANK_PRICE_VALID_THROUGH=
# Do not put real API keys in this example or in Git.

# VikingDB BGE-M3: backend=viking needs a newly built hybrid generation.
RAG_VIKING_API_KEY=
RAG_VIKING_EMBEDDING_ENDPOINT=https://api-vikingdb.vikingdb.cn-beijing.volces.com/api/vikingdb/embedding
RAG_VIKING_EMBEDDING_MODEL=bge-m3
RAG_VIKING_EMBEDDING_VERSION=default
# This is OUR service-configuration revision, not a pinned upstream model weight revision.
RAG_VIKING_EMBEDDING_REVISION=viking-bge-m3-default-v1
RAG_VIKING_BATCH_SIZE=4
RAG_VIKING_WINDOW_CHARS=1200
RAG_VIKING_TIMEOUT_SECONDS=30
# Verify a maximum CNY cost for ONE request of the configured batch size/window.
# Blank deliberately blocks network. Unknown usage keeps the full reservation.
RAG_VIKING_REQUEST_UPPER_BOUND_CNY=
RAG_VIKING_PRICE_VERIFIED_ON=
RAG_VIKING_PRICE_VALID_THROUGH=
